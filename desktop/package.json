{
  "name": "finora-desktop",
  "productName": "Finora",
  "version": "1.0.0",
  "description": "Finora personal finance — offline desktop app for Windows, macOS and Linux",
  "author": "Finora",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:main": "node scripts/build.mjs",
    "build:renderer": "npm run build -w client --prefix .. && node scripts/copy-renderer.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dev": "node scripts/build.mjs && cross-env FINORA_DEV_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "pack": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "~5.8"
  }
}
