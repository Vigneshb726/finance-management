// Finance Management System — PostgreSQL schema.
//
// Prisma is used only for migrations (prisma migrate). Queries are written once in
// packages/core with Kysely and run on PostgreSQL here and on SQLite in the
// desktop/mobile apps (packages/core/src/db/sqliteMigrations.ts mirrors this schema).
// Money columns are integer paise; ids are generated by the application.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  OTHER
}

enum NotificationType {
  BUDGET_EXCEEDED
  BUDGET_WARNING
  GOAL_MILESTONE
  MONTHLY_SUMMARY
  SYSTEM
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id                   String          @id @default(cuid())
  name                 String
  email                String          @unique
  passwordHash         String
  currency             String          @default("INR")
  theme                ThemePreference @default(SYSTEM)
  notifyBudgetAlerts   Boolean         @default(true)
  notifyGoalMilestones Boolean         @default(true)
  notifyMonthlySummary Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  goals         FinancialGoal[]
  notifications Notification[]
  recurring     RecurringTransaction[]
}

model Category {
  id        String          @id @default(cuid())
  name      String
  type      TransactionType @default(EXPENSE)
  color     String          @default("#64748b")
  icon      String          @default("tag")
  isDefault Boolean         @default(false)
  userId    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  budgetCategories BudgetCategory[]
  recurring        RecurringTransaction[]

  @@unique([userId, type, name])
  @@index([userId, type])
}

model Transaction {
  id            String          @id @default(cuid())
  type          TransactionType
  amount        BigInt // paise
  description   String
  date          DateTime        @db.Date
  paymentMethod PaymentMethod   @default(CASH)
  notes         String?
  categoryId    String
  userId        String
  recurringId   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction (checked at end of statement) lets user deletion cascade cleanly,
  // while the API reassigns transactions before a category is deleted.
  category  Category              @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([recurringId, date])
  @@index([userId, date(sort: Desc)])
  @@index([userId, type, date])
  @@index([categoryId])
}

model RecurringTransaction {
  id              String              @id
  userId          String
  type            TransactionType
  amount          BigInt // paise
  description     String
  categoryId      String
  paymentMethod   PaymentMethod       @default(CASH)
  notes           String?
  frequency       RecurrenceFrequency
  interval        Int                 @default(1)
  startDate       DateTime            @db.Date
  endDate         DateTime?           @db.Date
  nextDate        DateTime?           @db.Date
  occurrenceCount Int                 @default(0)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  transactions Transaction[]

  @@index([userId, isActive, nextDate])
  @@index([categoryId])
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  month       Int // 1-12
  year        Int
  totalAmount BigInt // paise
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([userId, year, month])
}

model BudgetCategory {
  id         String  @id @default(cuid())
  budgetId   String
  categoryId String
  amount     BigInt // paise

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@index([categoryId])
}

model FinancialGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  targetAmount  BigInt // paise
  currentAmount BigInt    @default(0) // paise
  targetDate    DateTime? @db.Date
  description   String?
  color         String    @default("#4f46e5")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  // Prevents duplicate alerts (e.g. one "budget exceeded" per budget scope)
  dedupeKey String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt(sort: Desc)])
}
