# ---------------------------------------------------------------------------
# Server environment — copy this file to server/.env and adjust the values.
#   cp .env.example server/.env
# Never commit the real .env file. Secrets stay on the server only.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_db?schema=public"

# JWT — use a long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Client (optional) — client/.env
# Leave unset in development: Vite proxies /api to http://localhost:5000.
# Set when the API is hosted on a different origin in production.
# VITE_API_URL=https://api.example.com/api
# ---------------------------------------------------------------------------
